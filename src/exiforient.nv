// exiforient.nv — orientation as one of eight named transforms.
//
// THE TAG NOBODY READS AND EVERYBODY SHOULD
//
// A camera held sideways writes the pixels the way the sensor saw
// them and records, in tag 0x0112, what has to be done to put them the
// right way up.  A program that ignores the tag shows a portrait
// photograph on its side.  A program that applies it and ALSO keeps
// the tag shows it sideways the other way in the next program that
// reads it.  Both failures are everywhere.
//
// AN ENUM AND NOT AN INTEGER
//
// The values are 1 to 8, and `6` is not something a reader of code can
// check.  `ExifRotate90` is.  Four of the eight also MIRROR, which is
// the half most implementations forget: they handle 1, 3, 6 and 8 and
// silently mishandle 2, 4, 5 and 7, which scanners and some phone
// front cameras do write.
//
// The names here are image-io-nv's, with this package's prefix, so
// that the two read the same way in one program.
//
// NOTHING HERE TOUCHES PIXELS
//
// This package has no image buffer and never will: it says what the
// file claims, and `swaps_dimensions` is the one derived fact a caller
// needs before it has decoded anything, because a 4000-by-3000 file
// with `ExifRotate90` is a 3000-by-4000 picture.

// The eight orientations tag 0x0112 can carry.
//
// Named for what has to be DONE rather than for the tag's number,
// because "6" is not something a reader can check and "rotate 90
// clockwise" is.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println(exiforient.orientation_name(ExifRotate90))   // rotate-90
// ```
pub enum ExifOrientation
    // 1: the rows are already the right way up.
    ExifUpright
    // 2: mirrored left to right.
    ExifMirrorH
    // 3: rotated 180 degrees.
    ExifRotate180
    // 4: mirrored top to bottom.
    ExifMirrorV
    // 5: mirrored left to right, then rotated 90 degrees clockwise.
    ExifMirrorHRotate90
    // 6: rotated 90 degrees clockwise.  The common one: a phone held
    // in portrait.
    ExifRotate90
    // 7: mirrored left to right, then rotated 270 degrees clockwise.
    ExifMirrorHRotate270
    // 8: rotated 270 degrees clockwise.
    ExifRotate270

// The lower-case name: `upright`, `mirror-h`, `rotate-180`,
// `mirror-v`, `mirror-h-rotate-90`, `rotate-90`,
// `mirror-h-rotate-270`, `rotate-270`.
//
// The same spellings image-io-nv uses, so that the two packages read
// the same way in one program.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println(exiforient.orientation_name(ExifMirrorHRotate270))
// ```
pub fn orientation_name(o: ExifOrientation) -> Str []
    todo("exif-nv.exiforient.orientation_name")

// The tag value an orientation is: 1 to 8.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println("${exiforient.tag_value(ExifRotate90)}")   // 6
// ```
pub fn tag_value(o: ExifOrientation) -> Int []
    todo("exif-nv.exiforient.tag_value")

// The orientation a tag value names, or `ExifUpright` for anything
// outside 1 to 8.
//
// LENIENT ON PURPOSE, and it is the same judgement image-io-nv made: a
// nonsense orientation tag is not a reason to fail to open a
// photograph, and treating it as upright is what every viewer does.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println(exiforient.orientation_name(exiforient.from_tag_value(99)))   // upright
// ```
pub fn from_tag_value(v: Int) -> ExifOrientation []
    todo("exif-nv.exiforient.from_tag_value")

// Whether restoring this orientation exchanges width and height.
//
// True for the four that involve a quarter turn: 5, 6, 7 and 8.  THE
// ONE DERIVED FACT A CALLER NEEDS BEFORE IT HAS DECODED ANYTHING — a
// 4000-by-3000 file with `ExifRotate90` is a 3000-by-4000 picture, and
// a thumbnail service that sized its output from the file's own
// dimensions gets every portrait photograph wrong.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println("${exiforient.swaps_dimensions(ExifRotate90)}")    // true
//     println("${exiforient.swaps_dimensions(ExifRotate180)}")   // false
// ```
pub fn swaps_dimensions(o: ExifOrientation) -> Bool []
    todo("exif-nv.exiforient.swaps_dimensions")

// Whether restoring this orientation mirrors the image.
//
// True for 2, 4, 5 and 7 — the half most implementations forget.
// Scanners and some phone front cameras write them.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println("${exiforient.mirrors(ExifMirrorH)}")    // true
//     println("${exiforient.mirrors(ExifRotate90)}")   // false
// ```
pub fn mirrors(o: ExifOrientation) -> Bool []
    todo("exif-nv.exiforient.mirrors")

// How many degrees clockwise restoring this orientation turns the
// image: 0, 90, 180 or 270.
//
// The mirroring is `mirrors`, and the two together are the whole
// transform: mirror first, then rotate.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println("${exiforient.rotation_degrees(ExifMirrorHRotate270)}")   // 270
// ```
pub fn rotation_degrees(o: ExifOrientation) -> Int []
    todo("exif-nv.exiforient.rotation_degrees")

// The orientation that undoes this one.
//
// What a tool applying the transform to the PIXELS writes back into
// the tag — which is `ExifUpright`, always, because the pixels are now
// upright.  It is spelled as a function rather than as the constant it
// is so that the intent reads at the call site: a file whose pixels
// have been rotated must have its tag cleared, and a tool that rotates
// and leaves the tag shows the picture sideways the other way in the
// next program that opens it.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println(exiforient.orientation_name(exiforient.after_applying(ExifRotate90)))
// ```
pub fn after_applying(o: ExifOrientation) -> ExifOrientation []
    todo("exif-nv.exiforient.after_applying")

// The orientation that is this one followed by that one.
//
// For a tool that rotates a picture that already had a tag: a file
// marked `ExifRotate90` that the user then turns 90 degrees again is
// `ExifRotate180`, and computing it by hand through the mirroring
// cases is where the errors are.
//
// ```novo
// use exiforient
//
// fn main() [io]
//     println(exiforient.orientation_name(
//         exiforient.compose(ExifRotate90, ExifRotate90)))   // rotate-180
// ```
pub fn compose(first: ExifOrientation, second: ExifOrientation) -> ExifOrientation []
    todo("exif-nv.exiforient.compose")
